# Copy to backend/.env for local development (backend/.env is git-ignored). Every variable has the SB_ prefix; the only
# other one the app reads is the standard OTEL_EXPORTER_OTLP_ENDPOINT (tracing stays off while it is unset).
# A commented line is optional and shows the default behavior; an empty value is treated as unset.

SB_ENV=dev
SB_DATABASE_URL=postgresql+asyncpg://sb:sb@localhost:5432/stellar_blaze
SB_LOG_LEVEL=INFO
SB_LOG_FORMAT=console
SB_DATA_DIR=data

# Release identity, set by the deploy (I1), not stamped into the image; "unknown" outside a release.
SB_GIT_SHA=unknown

# Outbound HTTP
SB_HTTP_TIMEOUT_S=60.0
# Default is "stellar-blaze/<package version>"; set it only to identify a deployment to an upstream.
# SB_HTTP_USER_AGENT=
SB_OPEN_METEO_PREVIOUS_RUNS_URL=https://previous-runs-api.open-meteo.com/v1/forecast
SB_IEM_ASOS_URL=https://mesonet.agron.iastate.edu/cgi-bin/request/asos.py
SB_GHCNH_BASE_URL=https://www.ncei.noaa.gov/oa/global-historical-climatology-network/hourly/access/by-year
# Seconds between the starts of two requests that reach one service (0 turns pacing off).
SB_IEM_REQUEST_INTERVAL_S=2.0
SB_OPEN_METEO_REQUEST_INTERVAL_S=6.0

# Health checks and heat-strain computation budgets (seconds)
SB_READINESS_TIMEOUT_S=2.0
SB_PHS_TIMEOUT_S=10.0

# Evolvability (ADR 0009, ADR 0010). open_meteo | replay
SB_FORECAST_SOURCE=open_meteo
SB_RULESETS_DIR=rulesets
SB_MODELS_DIR=models
# The git default of the runtime config (tunables, flags): the starting config until a database version is active.
SB_RUNTIME_CONFIG_SEED=config/runtime/default.toml
# Pins for back-tests and database-less development runs, unset by default: no SB_RULESET_ID resolves the ruleset by
# date; no SB_MODEL_ID serves the uncorrected forecast. With SB_ENV=prod a set pin fails startup (ADR 0010: use the
# runtime config).
# SB_RULESET_ID=
# SB_MODEL_ID=
