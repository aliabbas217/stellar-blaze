# Build context is backend/. The Dockerfile copies only pyproject.toml, uv.lock, src/, alembic/, alembic.ini, rulesets/
# and models/, so this file keeps the context small and keeps secrets and local state out of it.
# Never exclude rulesets/ or models/: they ship inside the image (ADR 0009).

# Local environments and caches
.venv
.mypy_cache
.ruff_cache
.pytest_cache
.import_linter_cache
.numba-cache
**/__pycache__
**/*.pyc
.coverage
htmlcov

# Secrets and local data (.env.example is documentation, not needed in the image)
.env
.env.*
data

# Not part of the runtime image
tests
