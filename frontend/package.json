{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-sw-strings.ts && node scripts/build-data-manifest.mjs",
    "build": "next build",
    "start": "next start",
    "start:standalone": "node scripts/start-standalone.mjs",
    "lint": "next typegen && eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:live": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/e2e-live.mjs",
    "design:lint": "node scripts/design-lint.mjs",
    "api:gen": "openapi-typescript openapi/stellar-blaze.openapi.json -o src/api/schema.d.ts",
    "api:check": "pnpm api:gen && git diff --exit-code src/api/schema.d.ts",
    "mock:api": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/mock-api.ts",
    "push:send": "node --env-file-if-exists=.env.spike.local --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/send-test-push.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@serwist/turbopack": "9.5.13",
    "@tanstack/react-query": "5.107.1",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "lucide-react": "1.70.0",
    "next": "16.4.6",
    "next-intl": "4.14.9",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "serwist": "9.5.13",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@google/design.md": "0.4.0",
    "@lhci/cli": "0.16.0",
    "@msw/serve": "0.11.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-react": "6.3.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "fake-indexeddb": "6.2.8",
    "jsdom": "31.0.0",
    "msw": "3.0.4",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.32",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0",
    "web-push": "4.0.0"
  }
}
