{
  "ci": {
    "collect": {
      "startServerCommand": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/serve-stack.mjs",
      "startServerReadyPattern": "Ready in",
      "startServerReadyTimeout": 60000,
      "url": ["http://127.0.0.1:3000/en/worker", "http://127.0.0.1:3000/en/worker/alerts"],
      "numberOfRuns": 3
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "/en/worker",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
            "categories:accessibility": ["error", { "minScore": 1, "aggregationMethod": "median-run" }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 2500, "aggregationMethod": "median-run" }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1, "aggregationMethod": "median-run" }],
            "total-blocking-time": ["error", { "maxNumericValue": 200, "aggregationMethod": "median-run" }],
            "resource-summary:script:size": ["error", { "maxNumericValue": 174080, "aggregationMethod": "median-run" }]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
